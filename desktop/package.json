{
  "name": "lan-bridge-desktop",
  "version": "0.1.0",
  "description": "LAN BRIDGE Desktop - 可信局域网 OpenAI 兼容模型桥接与上游路由管理工具",
  "author": "Orua",
  "homepage": "https://github.com/Orua/lan-bridge",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "preelectron:build": "npm run verify:backend",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "test:electron": "tsc -p tsconfig.electron.json && node --test tests/bridge-lifecycle.test.cjs tests/verify-backend.test.cjs",
    "verify:backend": "node scripts/verify-backend.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^8.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
